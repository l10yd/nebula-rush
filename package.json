{
  "name": "nebula-rush",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NEBULA RUSH — hyperspace arcade racing in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --experimental-transform-types --no-warnings --test tests/"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
